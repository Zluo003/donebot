# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=donebot
DONEBOT_BIND_ADDRESS=127.0.0.1
DONEBOT_HTTP_PORT=18880
# Leave empty to use http://localhost:${DONEBOT_HTTP_PORT:-18880}.
DONEBOT_PUBLIC_URL=
# Leave empty to inherit DONEBOT_PUBLIC_URL.
DONEBOT_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set DONEBOT_PUBLIC_URL to https:// followed by the same hostname.
# Requires DONEBOT_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
DONEBOT_HTTPS_HOST=
DONEBOT_BASE_IMAGE=donebot-core:local
DONEBOT_LOCAL_IMAGE=donebot-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
DONEBOT_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
DONEBOT_DATA_EXTERNAL=false
