:80 {
	map {host} {upstream_scheme} {
		{$DONEBOT_HTTPS_HOST:https-disabled.invalid} {$DONEBOT_UPSTREAM_SCHEME:http}
		default http
	}
	encode zstd gzip
	handle /hooks/* {
		reverse_proxy unix//run/donebot/hooks.sock
	}
	handle {
		reverse_proxy unix//run/donebot/http.sock {
			header_up X-Forwarded-Proto {upstream_scheme}
			header_up -Accept-Encoding
			flush_interval -1
		}
	}
}
