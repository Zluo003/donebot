{
    admin off
    auto_https off
}

http://:{$DONEBOT_HTTP_PORT:8080} {
    bind 127.0.0.1
    map {host} {upstream_scheme} {
        {$DONEBOT_HTTPS_HOST:https-disabled.invalid} https
        default http
    }
    encode zstd gzip
    handle /hooks/* {
        reverse_proxy 127.0.0.1:{$DONEBOT_WEBHOOK_PORT:18900}
    }
    handle {
        reverse_proxy 127.0.0.1:{$DONEBOT_PORT:18899} {
            header_up X-Forwarded-Proto {upstream_scheme}
            flush_interval -1
        }
    }
}
